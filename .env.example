# Copy to .env for Docker Compose or backend/.env for local backend development. Never commit real values.
POSTGRES_USER=pme
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=pme
DATABASE_URL=postgresql://pme:replace-with-a-long-random-password@localhost:5432/pme?schema=public
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# Generate a long random admin token. Requests use x-pme-admin-token. Keep private.
PME_ADMIN_TOKEN=replace-with-a-long-random-admin-token
# 32-byte key encoded as 64 hex characters. Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters
# Allow private/local URLs only for local development and test stores.
ALLOW_PRIVATE_STORE_URLS=false
